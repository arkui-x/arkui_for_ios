component_modules_libs = []

foreach(module, component_modules) {
  sub_name = string_replace(module, "_", "")
  if (module == "shape") {
    sub_name = "shapes"
  }
  module_name = "arkui_$sub_name"
  module_path = module
  if (module == "span") {
    module_path = "text/span"
  }
  lib_name = "lib" + module_name
  if (module == "canvas") {
    ohos_shared_library(module_name) {
      ldflags = [
        "-Wl",
        "-install_name",
        "@rpath/${lib_name}.framework/$lib_name",
      ]
      deps = [ "$ace_root/frameworks/core/components_ng/pattern/${module_path}:ace_core_components_${module}_pattern_ng_ios" ]
      deps += [ libace_target ]
      deps += [
        "//foundation/graphic/graphic_2d/rosen/modules/2d_graphics:2d_graphics_source_ios",
        "//third_party/skia:skia_canvaskit_static",
      ]
      part_name = ace_engine_part
      subsystem_name = ace_engine_subsystem
    }
  } else if (module == "video") {
    ohos_shared_library(module_name) {
      ldflags = [
        "-Wl",
        "-install_name",
        "@rpath/${lib_name}.framework/$lib_name",
      ]
      deps = [ "$ace_root/frameworks/core/components_ng/pattern/${module_path}:ace_core_components_${module}_pattern_ng_ios" ]
      deps += [ libace_target ]

      part_name = ace_engine_part
      subsystem_name = ace_engine_subsystem
    }
  } else {
    ohos_shared_library(module_name) {
      ldflags = [
        "-Wl",
        "-install_name",
        "@rpath/${lib_name}.framework/$lib_name",
      ]
      deps = [ "$ace_root/frameworks/core/components_ng/pattern/${module_path}:ace_core_components_${module}_pattern_ng_ios" ]
      deps += [ libace_target ]

      part_name = ace_engine_part
      subsystem_name = ace_engine_subsystem
    }
  }

  ohos_combine_darwin_framework(lib_name) {
    deps = [ ":$module_name" ]

    subsystem_name = ace_engine_subsystem
    part_name = ace_engine_part
  }
  component_modules_libs += [ ":${lib_name}" ]
}

# Install packages
group("ace_packages") {
  deps = [
    ":libace_ndk",
    ":libarkui_ios",
  ]
  deps += common_napi_modules
  deps += common_plugin_modules
  deps += components_modules
  if (defined(use_components_lib) && use_components_lib) {
    deps += component_plugin_modules
  }
  deps += component_modules_libs
}
